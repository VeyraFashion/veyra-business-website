# Where styld-ai (FastAPI) is running.
STYLD_AI_BASE_URL=http://127.0.0.1:8000

# Canonical public origin used for Open Graph and other absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=https://business.example.com

# Only needed if SERVICE_API_KEY is set on the styld-ai service — leave blank in local dev.
STYLD_AI_SERVICE_KEY=

# interactive (~13-18s, cheaper) or premium (4K, slower, background-quality). Interactive is right
# for a live demo link.
STYLD_AI_QUALITY_PROFILE=interactive
