# Where editme-ai (FastAPI) is running.
EDITME_AI_BASE_URL=http://127.0.0.1:8000

# Only needed if SERVICE_API_KEY is set on the editme-ai service — leave blank in local dev.
EDITME_AI_SERVICE_KEY=

# interactive (~13-18s, cheaper) or premium (4K, slower, background-quality). Interactive is right
# for a live demo link.
EDITME_AI_QUALITY_PROFILE=interactive
