# Where veyra-ai (FastAPI) is running.
VEYRA_AI_BASE_URL=http://127.0.0.1:8000

# Only needed if SERVICE_API_KEY is set on the veyra-ai service — leave blank in local dev.
VEYRA_AI_SERVICE_KEY=

# interactive (~13-18s, cheaper) or premium (4K, slower, background-quality). Interactive is right
# for a live demo link.
VEYRA_AI_QUALITY_PROFILE=interactive
